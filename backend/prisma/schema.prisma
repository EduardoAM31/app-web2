// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}

model Genero {
  id     Int     @id @default(autoincrement())
  nome   String  @unique
  filmes Filme[]
}

model Filme {
  id                  Int       @id @default(autoincrement())
  titulo              String
  sinopse             String?
  classificacaoEtaria String
  duracao             Int
  generoId            Int
  genero              Genero    @relation(fields: [generoId], references: [id], onDelete: Cascade)
  sessoes             Sessao[]
}

model Sala {
  id       Int      @id @default(autoincrement())
  numero   Int      @unique
  fileiras Int      @default(5)
  colunas  Int      @default(10)
  sessoes  Sessao[]
}

model Sessao {
  id            Int        @id @default(autoincrement())
  filmeId       Int
  salaId        Int
  horarioInicio DateTime
  valorIngresso Float
  filme         Filme      @relation(fields: [filmeId], references: [id], onDelete: Cascade)
  sala          Sala       @relation(fields: [salaId], references: [id], onDelete: Cascade)
  ingressos     Ingresso[]
}

model Ingresso {
  id        Int         @id @default(autoincrement())
  sessaoId  Int
  tipo      TipoIngresso
  valorPago Float
  assento   String?
  sessao    Sessao       @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  pedidos   PedidoIngresso[]

  @@unique([sessaoId, assento])
}

model LancheCombo {
  id        Int                 @id @default(autoincrement())
  nome      String
  descricao String
  preco     Float
  itens     String?
  pedidos   PedidoLancheCombo[]
}

model Pedido {
  id        Int                 @id @default(autoincrement())
  valorTotal Float
  dataHora  DateTime            @default(now())
  ingressos PedidoIngresso[]
  lanches   PedidoLancheCombo[]
}

model PedidoIngresso {
  pedidoId   Int
  ingressoId Int
  pedido     Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  ingresso   Ingresso @relation(fields: [ingressoId], references: [id], onDelete: Cascade)

  @@id([pedidoId, ingressoId])
}


model PedidoLancheCombo {
  pedidoId       Int
  lancheComboId  Int
  quantidade     Int      @default(1)
  pedido       Pedido      @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  lancheCombo  LancheCombo @relation(fields: [lancheComboId], references: [id], onDelete: Cascade)
  
  @@id([pedidoId, lancheComboId])
}

enum TipoIngresso {
  INTEIRA
  MEIA
}
